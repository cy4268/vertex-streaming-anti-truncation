# Optional: copy to .env.docker, then use docker compose --env-file .env.docker ...
# These are deployment settings; configure Google credentials in the web console.
IMAGE_TAG=latest
DOCKER_BIND_IP=127.0.0.1
CONSOLE_PORT=4780
GATEWAY_PORT=4781
# Browser-facing console origin: scheme + hostname/IP + published port, no path.
GUI_ORIGIN=http://127.0.0.1:4780
# Address to show/copy in the console for your API client.
GATEWAY_PUBLIC_URL=http://127.0.0.1:4781/v1
